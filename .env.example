# Server Check configuration template
# Copy this file to .env, replace every placeholder, and never commit the resulting .env file.

# Application runtime
# Use production only when the central service is deployed behind HTTPS.
NODE_ENV=development
# Network interface and port used by the Node.js API.
HOST=127.0.0.1
PORT=3000
# Public URL used when generating agent heartbeat endpoints. Every monitored server
# must be able to reach it; do not use 127.0.0.1 unless the agent is on this host.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Database
# MySQL connection used by the central API and workers.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=server_check
DB_USER=server_check_app
# Keep the database password private; an empty value is accepted only when intentional.
DB_PASSWORD=replace-me
# Connection pool size; allowed range is 1 through 100.
DB_CONNECTION_LIMIT=10

# Internal authentication
# Issuer and audience must remain stable for active JWT sessions.
JWT_ISSUER=server-check
JWT_AUDIENCE=server-check-backoffice
# Use a private random secret containing at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-bytes
# JWT lifetime: 300 through 86400 seconds.
JWT_TTL_SECONDS=900
# Server-side idle session timeout: 900 through 604800 seconds.
SESSION_IDLE_TIMEOUT_SECONDS=28800
